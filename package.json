{
  "name": "opencode-precost",
  "version": "0.3.0",
  "description": "Cost range preview and approval gate before a task runs in coding agents (OpenCode, Claude Code). An estimate, not a spending cap.",
  "type": "module",
  "private": true,
  "bin": {
    "precost": "bin/precost.js"
  },
  "scripts": {
    "test": "node --test",
    "e2e:opencode": "bash scripts/opencode-gate-e2e.sh",
    "e2e:claude": "bash scripts/claude-code-e2e.sh",
    "e2e:claude-failure": "bash scripts/claude-failure-e2e.sh",
    "e2e:opencode-tui": "python3 scripts/opencode-tui-e2e.py",
    "e2e:claude-tui": "python3 scripts/claude-tui-e2e.py",
    "e2e:opencode-ledger": "bash scripts/opencode-ledger-e2e.sh",
    "e2e:claude-plugin": "bash scripts/claude-plugin-e2e.sh",
    "e2e:claude-plugin-failure": "bash scripts/claude-plugin-failure-e2e.sh",
    "e2e:native": "node scripts/e2e-native.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@opencode-ai/plugin": "1.19.6"
  },
  "main": "adapters/opencode/index.js",
  "exports": {
    ".": "./adapters/opencode/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "adapters",
    "bin",
    "src",
    "data",
    "docs",
    "hooks",
    ".claude-plugin",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "claude-code",
    "cost",
    "budget",
    "estimate"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glauberportella/opencode-precost.git"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "1.19.6"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  }
}
